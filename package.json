{
  "name": "uiland-mcp",
  "version": "0.3.0",
  "description": "Personal MCP server for searching and saving Uiland screens from Claude Code, Antigravity, Cursor and other MCP clients",
  "type": "module",
  "bin": {
    "uiland-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "auth": "node dist/index.js auth",
    "probe": "node dist/index.js probe",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "discover": "node dist/index.js discover"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
